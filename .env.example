# Copy this file to .env on each device and fill it in. Never commit .env.

# --- HiveMQ Cloud (same cluster as the subscriber) ---
HIVEMQ_HOST=494e32fb3e754909802669fab3d9856b.s1.eu.hivemq.cloud
HIVEMQ_PORT=8883
HIVEMQ_USER=admin
HIVEMQ_PASSWORD=2468g0a7A7B7*
MQTT_TLS=true

# --- Device identity ---
# Leave DEVICE_ID empty to auto-detect. Run `python publisher.py --show-id`
# and put the printed ID in the subscriber's DEVICE_MAPPING.
DEVICE_ID=
# Auto-detect source when DEVICE_ID is empty: machine-id | serial | hostname
#   machine-id : stable per OS install, works everywhere (recommended)
#   serial     : BIOS serial from the sticker; often "Default string" on mini PCs,
#                needs root on Linux x86. Falls back to machine-id if unusable.
#   hostname   : the computer name (changes if someone renames the PC)
DEVICE_ID_SOURCE=machine-id

# --- Heartbeat ---
# Must match the subscriber's MQTT_TOPIC (+/heartbeat).
# {device_id} and {hostname} are filled in automatically.
HEARTBEAT_TOPIC={device_id}/heartbeat
# Seconds between heartbeats. The subscriber flags DOWN after 20s of silence.
HEARTBEAT_INTERVAL=5
# 0 = fire and forget, 1 = broker acknowledges each heartbeat
MQTT_QOS=1

# --- Logging ---
LOG_LEVEL=INFO
# Writes logs/publisher.log (rotated, 5 x 1 MB)
LOG_TO_FILE=true
